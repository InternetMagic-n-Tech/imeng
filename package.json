{
  "name": "imeng",
  "version": "1.3.0",
  "description": "",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "start": "npm run build && node dist/server.js",
    "start:ephemeral": "npm run build && node dist/server.js --no-persist",
    "dev": "node node_modules/vite-node/dist/cli.mjs scripts/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "hub": "npm run build && node dist/hub.js",
    "hub:ephemeral": "npm run build && node dist/hub.js --no-persist",
    "hub:dev": "node node_modules/vite-node/dist/cli.mjs scripts/hub.ts",
    "judge": "npm run build && node dist/judge-host.js",
    "migrate": "node node_modules/vite-node/dist/cli.mjs scripts/migrate.ts",
    "schema": "node node_modules/vite-node/dist/cli.mjs scripts/schema.ts",
    "doctor": "node node_modules/vite-node/dist/cli.mjs scripts/doctor.ts",
    "sessions": "node node_modules/vite-node/dist/cli.mjs scripts/sessions.ts",
    "start:production": "npm run build && NODE_ENV=production node dist/server.js",
    "discord": "node node_modules/vite-node/dist/cli.mjs scripts/discord-bridge.ts",
    "driver": "node scripts/driver.mjs",
    "how-to-test": "node scripts/driver.mjs how-to-test",
    "build:prompts": "node scripts/driver.mjs build",
    "check:games": "node scripts/driver.mjs check",
    "zip:changes": "node scripts/driver.mjs zip",
    "db:migrate": "node node_modules/vite-node/dist/cli.mjs scripts/db-migrate.ts",
    "db:cleanup": "node node_modules/vite-node/dist/cli.mjs scripts/db-cleanup.ts",
    "nuke": "node scripts/nuke.mjs",
    "live": "node scripts/live-table.mjs",
    "env:init": "node scripts/make-env.mjs",
    "lint": "eslint ."
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "debug": "^4.4.3",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10",
    "dotenv-expand": "^12.0.3",
    "express": "^5.3.0",
    "gray-matter": "^4.0.3",
    "kysely": "^0.29.9",
    "minio": "^8.0.7",
    "p-limit": "^7.3.3",
    "p-retry": "^9.0.0",
    "pg": "^8.23.1",
    "redis": "^6.3.1",
    "sharp": "^0.35.5",
    "yahoo-finance2": "^4.0.6",
    "yaml": "^2.9.1",
    "yargs": "^18.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/yargs": "^17.0.35",
    "better-sqlite3": "^13.2.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
