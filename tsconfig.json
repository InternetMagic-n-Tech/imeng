{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["scripts/server.ts", "scripts/judge-host.ts", "scripts/doctor.ts", "vite.config.ts", "src/**/*.ts", "src/**/*.d.cts", "tests/**/*.ts"]
}
